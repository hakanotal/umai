# Copy to .env and fill in. .env is gitignored; this template is committed.
# Only two values genuinely differ between the Mac and the Pi: the Telegram
# mode and the database URL. Keep it that way.

UMAI_ENV=dev                     # dev | prod

# --- Telegram --------------------------------------------------------------
# Two bots, two tokens. Telegram allows one consumer per token, so a dev
# instance polling the production token steals messages from the real bot.
TELEGRAM_BOT_TOKEN=              # umai_dev_bot in dev, umai_bot in prod
TELEGRAM_WEBHOOK_URL=            # prod only. dev uses long polling.
TELEGRAM_WEBHOOK_SECRET=         # prod only

# --- Access ----------------------------------------------------------------
# The phrase somebody has to send before the bot will talk to them. This
# replaced an allowlist of numeric ids, which meant admitting a friend was an
# edit to this file and a restart.
#
# Not stored anywhere: the bot compares against this value and no row holds a
# copy. Rotating it is an edit and a restart, and it locks out nobody who is
# already through, because admission is recorded on their row. Five wrong
# guesses blocks the guesser for good, so the phrase only has to survive five
# guesses — a few unrelated words, not a password. Minimum twelve characters,
# enforced at load.
UMAI_INVITE_CODE=                # e.g. "correct horse battery staple"

# Your own numeric Telegram id. The one account that skips the phrase, because
# a fresh deployment otherwise has nobody who can admit anybody — including
# themselves. Also the account that gets /users, /block and /delete_user.
# Find it by messaging @userinfobot.
UMAI_BOOTSTRAP_ADMIN_TELEGRAM_ID=

# --- Models ----------------------------------------------------------------
OPENROUTER_API_KEY=
UMAI_PROVIDER=openrouter

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://umai:dev@localhost:5433/umai
POSTGRES_PASSWORD=               # prod only, consumed by docker-compose.yml

# --- Ingest ----------------------------------------------------------------
# Read once, by the multi-user migration, which moves it onto the oldest user's
# row so an already-configured phone keeps posting unchanged. After that the
# token is per user and lives in the database; /token shows it. Safe to delete
# from this file once you have migrated.
HEALTH_INGEST_TOKEN=             # legacy; see the note above
MEDIA_DIR=./data/media
UMAI_HTTP_HOST=127.0.0.1         # containers override this to 0.0.0.0 in
                                 # compose; see docker-compose.yml for why.
UMAI_HTTP_PORT=8000

# --- Deploy ----------------------------------------------------------------
UMAI_PI_HOST=pi                  # ssh host or tailnet name
UMAI_IMAGE=ghcr.io/OWNER/umai:latest

# --- Defaults for a new person ---------------------------------------------
# Genuinely a system-wide default rather than anybody's body: everyone starts
# here and can change it in chat.
UMAI_WATER_TARGET_ML=2500

# Sex, height, birth date, goal rate, starting weight and cuisines used to live
# here, and were copied onto every user row that was created — which made the
# second person to use the bot a clone of the first, with the first person's
# BMR and safety floors. They are columns on `users` now, filled in by the
# onboarding wizard, per person.

# --- Locale ----------------------------------------------------------------
# A process default, and no longer load-bearing. It used to seed every user's
# timezone and decide when the evening summary fired; both are per-user columns
# now, and the scheduler stopped reading a zone at all when it became an
# interval tick. What is left is log timestamps and the headless scripts in
# tools/, which have no user to ask. Storage is UTC, always.
TZ=Europe/Istanbul
